{
  "schema_version": 5,
  "input": {
    "mode": "recording",
    "disparity_source": "raft_stereo"
  },
  "sdk": {
    "root": "${SDK_ROOT}",
    "base_config": null
  },
  "_help": "三组同帧回放：detseg_only、original、stereo。crop下原始Q8与新模型共同使用底部ROI；检测分割始终用完整左图。性能测试save_every_n=0；保存视差/点云使用crop_compare.json。CPU/BPU/RSS/耗时均监控，三个独立进程顺序运行。 DAG配置版：tasks定义功能；dag.sequence/parallel选择顺序和并行；所有依赖由sequence/parallel表达，不需要from/to。",
  "recording": {
    "directory": "${CAPTURE_ROOT}",
    "intrinsics_file": "${CAPTURE_ROOT}/metadata.json",
    "suite": "three_way",
    "order": "detseg_only,original,stereo",
    "limit": 100,
    "warmup_frames": 10,
    "repeat": 10,
    "save_every_n": 0,
    "viewer_max_points": 20000,
    "bpu": {
      "paths": [],
      "enabled": true,
      "sample_interval_ms": 100
    }
  },
  "engine": {
    "worker_threads": 3
  },
  "tasks": {
    "det": {
      "feature": "inference",
      "algorithm": "det",
      "inputs": {
        "image": "input.left"
      },
      "enabled": true
    },
    "seg": {
      "feature": "inference",
      "algorithm": "seg",
      "inputs": {
        "image": "input.left"
      },
      "enabled": true
    },
    "stereo": {
      "feature": "inference",
      "algorithm": "stereo",
      "inputs": {
        "left": "input.left",
        "right": "input.right"
      },
      "enabled": true
    },
    "cloud": {
      "feature": "cloud",
      "enabled": true
    },
    "calibration": {
      "feature": "calibration",
      "enabled": false
    },
    "labels": {
      "feature": "labels",
      "enabled": true
    },
    "transform": {
      "feature": "transform",
      "enabled": true
    },
    "ground": {
      "feature": "ground",
      "enabled": true
    },
    "maps": {
      "feature": "maps",
      "enabled": true
    },
    "recharge": {
      "feature": "recharge",
      "enabled": false
    },
    "history": {
      "feature": "history",
      "enabled": false
    },
    "difference": {
      "feature": "temporal_difference",
      "enabled": false
    },
    "match": {
      "feature": "temporal_match",
      "enabled": false
    },
    "extension": {
      "feature": "temporal_extension",
      "enabled": false
    },
    "publish": {
      "feature": "publish",
      "enabled": true
    },
    "record": {
      "feature": "record",
      "enabled": false
    }
  },
  "dag": {
    "sequence": [
      {
        "parallel": [
          "det",
          "seg",
          {
            "sequence": [
              "stereo",
              "cloud"
            ]
          }
        ]
      },
      "labels",
      "transform",
      "ground",
      "maps",
      "publish"
    ]
  }
}
