  "disp_filter": {
    "_comment": "视差域拖影/飞点抑制，在反投影前生效。grad_check 是抑制遮挡边缘拖尾的关键。调参看 log_every_n 打的 cut_* 统计，以及 /percep_main/disp_frame（被判无效的像素为纯黑）",
    "enabled": true,
    "min_disp": 2.0,
