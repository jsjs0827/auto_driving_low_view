if(NOT DEFINED GENERATED_HEADER_DST)
  message(FATAL_ERROR "GENERATED_HEADER_DST is not defined")
endif()

if(NOT DEFINED GENERATED_HEADER_SRC_DIRS)
  message(FATAL_ERROR "GENERATED_HEADER_SRC_DIRS is not defined")
endif()

string(REPLACE "," ";" GENERATED_HEADER_SRC_DIRS "${GENERATED_HEADER_SRC_DIRS}")

set(GENERATED_HEADER_OWNER "")
if(CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux")
  get_filename_component(GENERATED_HEADER_DST_PARENT "${GENERATED_HEADER_DST}" DIRECTORY)
  find_program(STAT_EXECUTABLE stat)
  if(STAT_EXECUTABLE AND EXISTS "${GENERATED_HEADER_DST_PARENT}")
    execute_process(
      COMMAND "${STAT_EXECUTABLE}" -c "%u:%g" "${GENERATED_HEADER_DST_PARENT}"
      OUTPUT_VARIABLE GENERATED_HEADER_OWNER
      OUTPUT_STRIP_TRAILING_WHITESPACE
      ERROR_QUIET
    )
  endif()
endif()

file(REMOVE_RECURSE "${GENERATED_HEADER_DST}")
file(MAKE_DIRECTORY "${GENERATED_HEADER_DST}")

foreach(GENERATED_HEADER_SRC_DIR IN LISTS GENERATED_HEADER_SRC_DIRS)
  if(NOT EXISTS "${GENERATED_HEADER_SRC_DIR}")
    continue()
  endif()

  file(GLOB_RECURSE GENERATED_HEADERS
    LIST_DIRECTORIES false
    RELATIVE "${GENERATED_HEADER_SRC_DIR}"
    "${GENERATED_HEADER_SRC_DIR}/*.h"
    "${GENERATED_HEADER_SRC_DIR}/*.hpp"
  )

  foreach(GENERATED_HEADER IN LISTS GENERATED_HEADERS)
    get_filename_component(GENERATED_HEADER_DIR "${GENERATED_HEADER}" DIRECTORY)
    file(MAKE_DIRECTORY "${GENERATED_HEADER_DST}/${GENERATED_HEADER_DIR}")
    configure_file(
      "${GENERATED_HEADER_SRC_DIR}/${GENERATED_HEADER}"
      "${GENERATED_HEADER_DST}/${GENERATED_HEADER}"
      COPYONLY
    )
  endforeach()
endforeach()

if(GENERATED_HEADER_OWNER)
  find_program(CHOWN_EXECUTABLE chown)
  if(CHOWN_EXECUTABLE)
    execute_process(
      COMMAND "${CHOWN_EXECUTABLE}" -R "${GENERATED_HEADER_OWNER}" "${GENERATED_HEADER_DST}"
      RESULT_VARIABLE CHOWN_RESULT
      ERROR_VARIABLE CHOWN_ERROR
      ERROR_STRIP_TRAILING_WHITESPACE
    )
    if(NOT CHOWN_RESULT EQUAL 0)
      message(WARNING
        "Failed to chown ${GENERATED_HEADER_DST} to ${GENERATED_HEADER_OWNER}: ${CHOWN_ERROR}"
      )
    endif()
  endif()
endif()
