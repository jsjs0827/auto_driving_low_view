# Control commands for the independent RTK+VSLAM process.
uint8 CMD_START=1
uint8 CMD_STOP_AT_RETURN_ANCHOR=2
uint8 CMD_MEMORIZE_BASE_STATION=3
uint8 CMD_RESET=4  # 主动触发重定位（定位SDK重启，触发重新初始化）

uint8 cmd

# false: no saved dock latitude/longitude/altitude.
# true: a saved dock reference is available.
bool has_dock

# ENU datum selected for this mapping session.
float64 origin_latitude
float64 origin_longitude
float64 origin_altitude

# Transform from the map frame to this ENU frame, supplied by the Huace SDK.
float64 map2enu_tx
float64 map2enu_ty
float64 map2enu_tz
float64 map2enu_qx
float64 map2enu_qy
float64 map2enu_qz
float64 map2enu_qw

---

uint8 RESULT_REJECTED=0
uint8 RESULT_ACCEPTED=1

uint16 ERROR_NONE=0

uint8 result
string session_id
uint16 error_code
string message
