# ToNaviCmd.srv
int32 cmd

# cmd 指令说明：
#  1    - 导航退基站
#  10   - 导航开始转场
#  20   - 导航加载图层
#  21   - 地图被删除，导航清除割草轨迹
#  30   - 通知导航自动建图
#  40   - 导航沿边割草
#  41   - 导航弓字割草
#  42   - 导航实时修改割草高度
#  50   - 导航割草新任务准备
#  60   - 导航暂停割草任务
#  61   - 导航继续割草任务
#  70   - 导航开始执行重定位动作
#  71   - 导航停止执行重定位动作
#  100  - 导航停止割草任务
#  101  - 导航停止回充任务
#  200  - 导航开始回充任务
#  201  - 导航开始掉电对接基站任务

string json_data

# json_data 说明：
# cmd=20：{"map_id":0}
# cmd=21：{"map_id":0}
# cmd=10/40/41：
# {
#   "map_id": 1,
#   "area_id": 1,               // 转场到区域时必填
#   "target_type": 1,           // 1=作业区域，2=回充基站
#   "mowing_efficiency": 2,     // 割草效率: 1=eco 2=标准 3=高效
#   "cut_height": 0,            // 0-4 四个档位，对应60mm-20mm
#   "bow_angle": 0,             // 弓字角度，0–180度,默认长边为0度
#   "edge_mode": 1,             // 1=主刀盘，2=沿边刀盘
#   "edge_passes": 2,           // 沿边圈数
#   "edge_safe": 2              // 安全沿边开关: 1=开启，2=关闭
# }
# cmd=42：{"cut_height": 0}   // 0-4 四个档位，与 cmd 40/41 中含义一致
# cmd=50：{"area_ids": [1, 2]}
# 其余cmd：json_data留空

---
int32 result

#  result说明：立刻返回0