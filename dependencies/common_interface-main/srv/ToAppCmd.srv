# ToAppCmd.srv
int32 cmd
int32 status
string json_data

# cmd 指令说明：
#  1    - SLAM通知平台：是否闭合轮廓
#  20   - SLAM通知平台：图层保存完成
#  21   - SLAM通知平台：删除图层完成
#  30   - SLAM通知平台：地图保存完成
#  31   - SLAM通知平台：删除地图完成
#  40   - SLAM通知平台：开启定位完成
#  41   - SLAM通知平台：停止定位完成
#  50   - SLAM通知平台：终止建图事件 
#  51   - SLAM通知平台：孤岛提示事件 
#  52   - SLAM通知平台：区域大小提示事件 
#  53   - SLAM通知平台：多通道提示事件
#  54   - SlAM通知平台：起点可以设置
#  60   - SLAM通知平台: 重定位准备工作完成
#  61   - SLAM通知平台: 重定位执行完成
#  62   - SLAM通知平台：重定位停止完成
#  65   - SLAM通知平台：位姿记忆算法启动完成
#  66   - SLAM通知平台：位姿记忆完成
#  100  - SLAM通知平台：建图被结束
#  1001 - 导航通知平台：退基站完成
#  1010 - 导航通知平台：转场完成
#  1020 - 导航通知平台：图层加载完成
#  1021 - 导航通知平台：割草轨迹清除完成
#  1040 - 导航通知平台：沿边割草完成
#  1041 - 导航通知平台：弓字割草完成
#  1050 - 导航通知平台：割草新任务准备完成
#  1060 - 导航通知平台：暂停割草任务完成
#  1061 - 导航通知平台：继续割草任务完成
#  1070 - 导航通知平台：开始执行重定位动作完成
#  1071 - 导航通知平台：停止执行重定位动作完成
#  1100 - 导航通知平台：停止割草任务完成
#  1101 - 导航通知平台：停止回充任务完成
#  1200 - 导航通知平台：回充任务完成
#  1201 - 导航通知平台：掉电对接基站任务完成
#  2001 - 感知通知平台：感知地图发布模块启动完成
#  2002 - 感知通知平台：基站二维码发布模块启动完成
#  2021 - 感知通知平台：停止工作完成
#
# status 字段说明：
#  1 - 成功
#  2 - 失败
#
# cmd = 1,54  
# 1 - 可以
# 2 - 不可以
#
#json_data 字段说明：
#cmd = 30 需要附带 uint32 mapId
#
#
#

---
int32 result

#  result说明：立刻返回0