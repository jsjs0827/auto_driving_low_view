{
  "schema_version": 5,
  "input": {
    "mode": "ros",
    "disparity_source": "original_q8"
  },
  "sdk": {
    "root": "${SDK_ROOT}",
    "base_config": null
  },
  "camera_config": "camera.json",
  "visualization_config": "rviz_visualization.json",
  "_help": "RViz最小点云示例：ROS接收同帧左图/原Q8/左右CameraInfo，发布相机坐标点云和Q8；不运行检测/分割/打滑/地图。input.mode=camera时由ROS算法进程直取相机，不再启动raw_camera；raft_stereo需要左右图和真实Horizon ROS构建。 DAG配置版：tasks定义功能；dag.sequence/parallel选择顺序和并行；所有依赖由sequence/parallel表达，不需要from/to。",
  "engine": {
    "worker_threads": 2
  },
  "tasks": {
    "disparity": {
      "feature": "disparity",
      "enabled": true
    },
    "cloud": {
      "feature": "cloud",
      "enabled": true
    },
    "publish": {
      "feature": "publish",
      "enabled": true
    }
  },
  "dag": {
    "sequence": [
      "disparity",
      "cloud",
      "publish"
    ]
  }
}
