{
    "_comment": "回充二维码仓内配置（ROI/检测/DockPose）。板端安装到 /app/daye/config/ai_node/recharge_mark.json",
    "enabled": true,
    "publish_enabled": true,
    "run_every_n": 1,
    "min_interval_ms": 150,
    "use_hires": true,
    "intrinsics_source": "dataset",
    "publish_overlay": false,
    "overlay_max_width": 640,
    "yolo_assist_crop": false,
    "yolo_crop_scale": 2.0,
    "ai_recharge": {
