if(TARGET perception_algorithm_catalog)
  return()
endif()
get_filename_component(PERCEPTION_ALGORITHM_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(_generated "${CMAKE_BINARY_DIR}/generated/algorithms")
file(MAKE_DIRECTORY "${_generated}")
file(GLOB _manifests CONFIGURE_DEPENDS "${PERCEPTION_ALGORITHM_ROOT}/features/*/algorithm.json")
set(_catalog "#pragma once\n#include <string>\n#include <vector>\ninline std::vector<std::string> algorithmManifestData() { return {\n")
set(_factory "#include \"algorithm_runtime.hpp\"\n")
set(_factory_cases "")
set(_sources "")
set(_ids "")
foreach(_manifest IN LISTS _manifests)
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_manifest}")
  file(READ "${_manifest}" _json)
  string(JSON _id GET "${_json}" id)
  string(JSON _header GET "${_json}" header)
  string(JSON _symbol GET "${_json}" factory)
  if(NOT _id MATCHES "^[a-z][a-z0-9_]*$" OR _id IN_LIST _ids)
    message(FATAL_ERROR "Invalid/duplicate algorithm id in ${_manifest}")
  endif()
  if(NOT _symbol MATCHES "^[A-Za-z_][A-Za-z0-9_:]*$")
    message(FATAL_ERROR "Invalid algorithm factory in ${_manifest}")
  endif()
  list(APPEND _ids "${_id}")
  string(APPEND _catalog "R\"ALGOMANIFEST(${_json})ALGOMANIFEST\",\n")
  string(APPEND _factory "#include \"${_header}\"\n")
  string(APPEND _factory_cases "if (invocation.algorithm == \"${_id}\") return ${_symbol}(invocation);\n")
  string(JSON _count LENGTH "${_json}" sources)
  math(EXPR _last "${_count}-1")
  if(_count LESS 1)
    message(FATAL_ERROR "Algorithm ${_id} needs at least one source")
  endif()
  foreach(_i RANGE 0 ${_last})
    string(JSON _source GET "${_json}" sources ${_i})
    list(APPEND _sources "${PERCEPTION_ALGORITHM_ROOT}/${_source}")
  endforeach()
endforeach()
string(APPEND _catalog "}; }\n")
string(APPEND _factory "namespace perception::algorithms {\nstd::unique_ptr<runtime::Feature> create(const Invocation& invocation) {\n${_factory_cases}throw std::invalid_argument(\"Unregistered algorithm factory: \" + invocation.algorithm);\n}\n}\n")
file(WRITE "${_generated}/algorithm_manifest_data.hpp" "${_catalog}")
file(WRITE "${_generated}/algorithm_factories.cpp" "${_factory}")
add_library(perception_algorithm_catalog STATIC
  "${PERCEPTION_ALGORITHM_ROOT}/scheduling/algorithms/src/algorithm_catalog.cpp")
set_target_properties(perception_algorithm_catalog PROPERTIES POSITION_INDEPENDENT_CODE ON)
target_compile_features(perception_algorithm_catalog PUBLIC cxx_std_17)
target_include_directories(perception_algorithm_catalog PUBLIC
  "${PERCEPTION_ALGORITHM_ROOT}/scheduling/algorithms/include"
  "${PERCEPTION_ALGORITHM_ROOT}/scheduling/config/include"
  "${PERCEPTION_ALGORITHM_ROOT}/core/runtime/include"
  "${PERCEPTION_ALGORITHM_ROOT}/scheduling/dag/include"
  PRIVATE "${_generated}")
set(PERCEPTION_ALGORITHM_SOURCES "${_sources}" CACHE INTERNAL "Registered algorithm sources" FORCE)
set(PERCEPTION_ALGORITHM_FACTORIES "${_generated}/algorithm_factories.cpp" CACHE INTERNAL "Generated factories" FORCE)

function(perception_add_algorithm_runtime)
  if(TARGET perception_algorithm_runtime)
    return()
  endif()
  add_library(perception_algorithm_runtime STATIC
    "${PERCEPTION_ALGORITHM_FACTORIES}" ${PERCEPTION_ALGORITHM_SOURCES})
  set_target_properties(perception_algorithm_runtime PROPERTIES POSITION_INDEPENDENT_CODE ON)
  target_include_directories(perception_algorithm_runtime PRIVATE "${PERCEPTION_ALGORITHM_ROOT}")
  target_link_libraries(perception_algorithm_runtime PUBLIC perception_algorithm_catalog dag_framework)
  if(MSVC)
    target_compile_options(perception_algorithm_runtime PRIVATE /utf-8 /EHsc)
  endif()
endfunction()
