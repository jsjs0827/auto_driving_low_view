{
  "schema_version": 1,
  "input": {
    "mode": "camera",
    "intrinsics": "camera_sdk",
    "frame_id": "camera_optical_frame",
    "camera": {
      "sdk": "/app/data/metoak/lib/libMoGeneralSDK.so",
      "config": "/app/data/metoak/demo/config/x5_camera.cfg",
      "disparity_mode": 1,
      "timeout_ms": 3000,
      "retry_ms": 5
    }
  },
  "sdk": {
    "root": "${SDK_ROOT}",
    "detection_model": "${DET_MODEL}",
    "segmentation_model": "${SEG_MODEL}",
    "sample_step": 4,
    "render_maps": true
  },
  "stereo": {
    "model": "${STEREO_MODEL}",
    "input_mode": "resize",
    "input_width": 640,
    "input_height": 352
  },
  "output": {
    "save_root": "",
    "every_n": 10,
    "ply": true,
    "publish_clouds": true,
    "publish_maps": true,
    "publish_mask": true,
    "publish_input": false,
    "publish_every_n": 1,
    "metrics": true,
    "metrics_every_n": 1,
    "robot_frame_id": "base_link"
  },
  "dag": [
    {"id": "input", "feature": "input.camera", "depends_on": []},
    {"id": "disparity", "feature": "disparity.raft_stereo", "depends_on": ["input"]},
    {"id": "perception", "feature": "sdk.detect_segment_fuse", "depends_on": ["disparity"]},
    {"id": "report", "feature": "output.online", "depends_on": ["perception"]}
  ]
}
