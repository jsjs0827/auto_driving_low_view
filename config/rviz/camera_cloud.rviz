Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 25; 29; 36
    Fixed Frame: camera_optical_frame
    Frame Rate: 15
  Displays:
    - Class: rviz_default_plugins/PointCloud2
      Name: Camera point cloud
      Enabled: true
      Topic:
        Value: /perception_ros_so_demo/clouds/camera
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 1
      Style: Points
      Size (Pixels): 2
      Decay Time: 0
      Color Transformer: RGB8
      Position Transformer: XYZ
    - Class: rviz_default_plugins/Image
      Name: Disparity Q8 grayscale
      Enabled: true
      Topic:
        Value: /perception_ros_so_demo/disparity_q8
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 1
      Transport Hint: raw
      Normalize Range: false
      Min Value: 0
      Max Value: 36864
      Median window: 5
    - Class: rviz_default_plugins/Image
      Name: Fusion RGB image optional
      Enabled: false
      Topic:
        Value: /perception_ros_so_demo/fusion_map
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 1
      Transport Hint: raw
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 5
      Focal Point:
        X: 0
        Y: 0
        Z: 2
      Name: Current View
Window Geometry:
  Width: 1280
  Height: 850
