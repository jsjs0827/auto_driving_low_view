{
  "schema_version": 5,
  "input": {
    "mode": "ros",
    "disparity_source": "raft_stereo"
  },
  "sdk": {
    "root": "${SDK_ROOT}",
    "base_config": null
  },
  "camera_config": "../../camera.json",
  "visualization_config": "../../visualization.json",
  "features": {
    "ros": "../../features/ros/config.json",
    "offline": "../../features/offline/config.json",
    "stereo": "stereo.json",
    "inference": "../../features/inference/config.json",
    "detection": "detection.json",
    "segmentation": "segmentation.json",
    "pointcloud": "../../features/pointcloud/config.json",
    "fusion": "../../features/fusion/config.json",
    "metrics": "../../features/metrics/config.json",
    "temporal": "../../features/temporal/config.json",
    "recharge": "../../features/recharge/config.json"
  },
  "_help": "仅检测 ROS 左图，不订阅右图、视差或 CameraInfo，不生成点云。检测参数在 detection.json。运行 bash tools/run_pipeline.sh --config \"$PWD/config/examples/det_only_ros.json\" --run-dir /userdata/results/det_001。 DAG配置版：tasks定义功能；dag.sequence/parallel选择顺序和并行；所有依赖由sequence/parallel表达，不需要from/to。",
  "engine": {
    "worker_threads": 1
  },
  "tasks": {
    "det": {
      "feature": "inference",
      "algorithm": "det",
      "inputs": {
        "image": "input.left"
      },
      "enabled": true
    },
    "publish": {
      "feature": "publish",
      "enabled": true
    }
  },
  "dag": {
    "sequence": [
      "det",
      "publish"
    ]
  }
}
